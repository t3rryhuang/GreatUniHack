# LLM gateway: one Runware key routes Claude, Gemini and GPT (OpenAI-compatible API).
# If unset, the native keys below are used instead.
RUNWARE_API_KEY=
# Optional model overrides (Runware AIR ids)
# CLAUDE_MODEL=anthropic:claude@haiku-5.5
# GEMINI_MODEL=google:gemini@3.5-flash-lite
# GPT_MODEL=openai:gpt@5.4-mini

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Read-aloud for the iOS app (/nova/tts)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Arena storage. Injected automatically by the Vercel Upstash integration.
# Without them arenas are kept in memory (local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: default location for week-ahead weather/holiday context
USER_COUNTRY=GB
USER_SUBDIVISION=GB-ENG
USER_LAT=53.4808
USER_LON=-2.2426
